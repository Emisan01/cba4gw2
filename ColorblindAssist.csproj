<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ColorblindAssist</AssemblyName>
    <RootNamespace>ColorblindAssist</RootNamespace>
    <Version>0.1.1</Version>
    <Authors>Emisan01</Authors>
    <Product>ColorblindAssist</Product>
    <Description>A transparent, system-wide color aid for Windows.</Description>
    <RepositoryUrl>https://github.com/Emisan01/ColorblindAssist</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Start-ColorblindAssist.cmd" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
